{
  "manifest_version": 3,
  "name": "QuickTick \u2014 Floating Checklist",
  "version": "1.3.4",
  "description": "A draggable floating checklist with clear action-item deadline stats. Made by Rohan Aditya.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open QuickTick floating checklist",
    "default_icon": {
      "16": "icons/quicktick16.png",
      "32": "icons/quicktick32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/quicktick16.png",
    "32": "icons/quicktick32.png",
    "48": "icons/quicktick48.png",
    "128": "icons/quicktick128.png"
  }
}