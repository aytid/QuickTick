{
  "manifest_version": 3,
  "name": "QuickTick — Action Checklist",
  "version": "3.1.0",
  "description": "Kinetic Neo-Brutalist & Cyber-Tactile floating checklist and command dashboard. Made by Rohan Aditya.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open QuickTick floating checklist",
    "default_icon": {
      "16": "icons/quicktick16.png",
      "32": "icons/quicktick32.png"
    }
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/quicktick16.png",
    "32": "icons/quicktick32.png",
    "48": "icons/quicktick48.png",
    "128": "icons/quicktick128.png"
  }
}
